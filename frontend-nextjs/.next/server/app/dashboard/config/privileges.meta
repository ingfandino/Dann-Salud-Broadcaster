{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/dashboard/layout,_N_T_/dashboard/config/layout,_N_T_/dashboard/config/privileges/layout,_N_T_/dashboard/config/privileges/page,_N_T_/dashboard/config/privileges"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/dashboard/config/privileges/__PAGE__",
    "/dashboard/config/privileges",
    "/dashboard/config",
    "/dashboard",
    "/_index",
    "/_head"
  ]
}